---
interface DataPoint {
  fiscalYear: string;
  revenueB: number;
  spendingB: number;
  status: 'actual' | 'preliminary' | 'enacted' | 'projected';
}

interface Props {
  points: DataPoint[];
  note?: string;
}

const { points, note } = Astro.props;

// SVG layout
const W = 760;
const H = 300;
const PAD = { top: 24, right: 24, bottom: 52, left: 56 };
const plotW = W - PAD.left - PAD.right;
const plotH = H - PAD.top - PAD.bottom;

// Y domain
const yMin = 40;
const yMax = 60;
const yRange = yMax - yMin;

const n = points.length;
const xStep = plotW / (n - 1);

function xAt(i: number) {
  return PAD.left + i * xStep;
}
function yAt(valueB: number) {
  return PAD.top + plotH - ((valueB - yMin) / yRange) * plotH;
}

// Projection starts at first 'projected' point
const projIdx = points.findIndex(d => d.status === 'projected');
// Divider sits halfway between last non-projected and first projected
const dividerX = projIdx > 0
  ? (xAt(projIdx - 1) + xAt(projIdx)) / 2
  : -1;

function line(getter: (d: DataPoint) => number) {
  return points
    .map((d, i) => `${i === 0 ? 'M' : 'L'}${xAt(i).toFixed(1)},${yAt(getter(d)).toFixed(1)}`)
    .join(' ');
}

function gapPolygon() {
  const top = points.map((d, i) => `${xAt(i).toFixed(1)},${yAt(d.spendingB).toFixed(1)}`).join(' L');
  const bottom = [...points]
    .reverse()
    .map((d, i) => `${xAt(n - 1 - i).toFixed(1)},${yAt(d.revenueB).toFixed(1)}`)
    .join(' L');
  return `M${top} L${bottom} Z`;
}

const yTicks = [42, 46, 50, 54, 58];

// End-of-chart gap annotation
const lastPoint = points[n - 1];
const gapB = (lastPoint.spendingB - lastPoint.revenueB).toFixed(1);
const gapMidY = (yAt(lastPoint.spendingB) + yAt(lastPoint.revenueB)) / 2;
---

<div class="rounded-lg border border-white/10 bg-surface p-6">
  <div class="text-xs uppercase tracking-[0.2em] text-wtp-sky">Revenue vs. Spending</div>
  <h3 class="mt-1 text-lg font-bold text-white">The widening gap</h3>
  <p class="mt-1 text-sm text-wtp-cream/60">
    PA General Fund · $ billions · FY 2022–23 through 2029–30
  </p>

  <svg
    viewBox={`0 0 ${W} ${H}`}
    class="mt-6 w-full"
    aria-label="Line chart showing Pennsylvania spending growing faster than revenue, with the gap widening from under $2B in 2022-23 to a projected $8.4B by 2029-30"
  >
    <!-- Y grid lines + labels -->
    {yTicks.map(tick => (
      <g>
        <line
          x1={PAD.left} y1={yAt(tick)}
          x2={W - PAD.right} y2={yAt(tick)}
          stroke="rgba(255,255,255,0.06)" stroke-width="1"
        />
        <text
          x={PAD.left - 8} y={yAt(tick)}
          fill="rgba(245,242,232,0.4)"
          font-size="10" text-anchor="end" dominant-baseline="middle"
          font-family="Poppins, sans-serif"
        >${tick}B</text>
      </g>
    ))}

    <!-- Projected region background -->
    {dividerX > 0 && (
      <rect
        x={dividerX} y={PAD.top}
        width={W - PAD.right - dividerX} height={plotH}
        fill="rgba(255,255,255,0.02)"
      />
    )}

    <!-- Projected divider -->
    {dividerX > 0 && (
      <line
        x1={dividerX} y1={PAD.top}
        x2={dividerX} y2={PAD.top + plotH}
        stroke="rgba(255,255,255,0.18)" stroke-width="1" stroke-dasharray="4,3"
      />
    )}

    <!-- Gap fill -->
    <path d={gapPolygon()} fill="rgba(200,38,44,0.13)" />

    <!-- Revenue line -->
    <path d={line(d => d.revenueB)} fill="none" stroke="#7EC7DA" stroke-width="2.5" stroke-linejoin="round" />

    <!-- Spending line -->
    <path d={line(d => d.spendingB)} fill="none" stroke="#C8262C" stroke-width="2.5" stroke-linejoin="round" />

    <!-- Data dots -->
    {points.map((d, i) => (
      <>
        <circle cx={xAt(i)} cy={yAt(d.revenueB)} r="3.5" fill="#7EC7DA" />
        <circle cx={xAt(i)} cy={yAt(d.spendingB)} r="3.5" fill="#C8262C" />
      </>
    ))}

    <!-- X-axis labels -->
    {points.map((d, i) => (
      <text
        x={xAt(i)} y={H - PAD.bottom + 18}
        fill="rgba(245,242,232,0.45)"
        font-size="9.5" text-anchor="middle"
        font-family="Poppins, sans-serif"
      >{d.fiscalYear}</text>
    ))}

    <!-- "Projected →" label -->
    {dividerX > 0 && (
      <text
        x={dividerX + 7} y={PAD.top + 12}
        fill="rgba(245,242,232,0.3)"
        font-size="9" text-anchor="start"
        font-family="Poppins, sans-serif"
      >Projected →</text>
    )}

    <!-- Gap annotation at right edge -->
    <text
      x={xAt(n - 1) + 6} y={gapMidY}
      fill="rgba(200,38,44,0.85)"
      font-size="10" text-anchor="start" dominant-baseline="middle"
      font-family="Poppins, sans-serif"
      font-weight="600"
    >${gapB}B gap</text>
  </svg>

  <!-- Legend -->
  <div class="mt-3 flex flex-wrap items-center gap-5 text-xs text-wtp-cream/55">
    <span class="flex items-center gap-1.5">
      <span class="inline-block h-0.5 w-5 rounded bg-wtp-sky"></span>Revenue
    </span>
    <span class="flex items-center gap-1.5">
      <span class="inline-block h-0.5 w-5 rounded bg-wtp-red"></span>Spending
    </span>
    <span class="flex items-center gap-1.5">
      <span class="inline-block h-3 w-4 rounded-sm" style="background:rgba(200,38,44,0.18)"></span>Gap
    </span>
  </div>

  {note && (
    <p class="mt-3 text-xs italic text-wtp-cream/35">{note}</p>
  )}
  <p class="mt-1 text-xs text-wtp-cream/30">Source: PA Independent Fiscal Office (IFO) · ifo.state.pa.us</p>
</div>
