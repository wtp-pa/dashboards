---
import { config } from '../../config';
import projections from '../../../data/projections.json';
import keyStats from '../../../data/key-stats.json';
import population from '../../../data/population.json';
import revenueSources from '../../../data/revenue-sources.json';
import spendingByCategory from '../../../data/spending-by-category.json';
import rescueDoc from '../../../data/rescue-proposals.json';
import spendingCutsDoc from '../../../data/spending-cut-proposals.json';
import federalByCounty from '../../../data/federal-funds-by-county.json';
import DeficitClock from '../../components/DeficitClock';
import PersonalImpactCalculator from '../../components/PersonalImpactCalculator';
import RainyDayCountdown from '../../components/RainyDayCountdown';
import BudgetPlan from '../../components/BudgetPlan';
import BudgetBreakdown from '../../components/BudgetBreakdown.astro';
import SpendingRevenueTrend from '../../components/SpendingRevenueTrend.astro';
import IFOPublications from '../../components/IFOPublications.astro';
import FederalContext from '../../components/FederalContext.astro';
import FederalCliffScenarios from '../../components/FederalCliffScenarios.astro';
import CountyFederalImpact from '../../components/CountyFederalImpact';
import ShareRow from '../../components/ShareRow.astro';
import DashboardNav from '../../components/shared/DashboardNav.astro';
import SupportTipCTA from '../../components/shared/SupportTipCTA.astro';
import '../../styles/global.css';

const currentFY = projections.projections.find((p) => p.fiscalYear === '2026-27');
const annualDeficit = currentFY?.structuralDeficitUSD ?? 6_700_000_000;

const stat = (key: string) => keyStats.stats.find((s) => s.key === key);
const familyShare = stat('deficitPerFamilyOf4USD');
const rainyDayBalance = stat('rainyDayFundBalanceUSD');

const baseFamilyShareUSD = typeof familyShare?.value === 'number' ? familyShare.value : 1500;
const rainyDayUSD = typeof rainyDayBalance?.value === 'number' ? rainyDayBalance.value : 7_000_000_000;

const annualB = (annualDeficit / 1e9).toFixed(1);
const gapB = ((spendingByCategory.totalUSD - revenueSources.totalUSD) / 1e9).toFixed(1);

const pageTitle = `${config.project.name} — ${config.party.shortName}`;
const pageDescription = `Pennsylvania faces a $${annualB}B structural deficit. Track it in real time. Built by ${config.party.shortName}.`;
const siteOrigin = Astro.site ?? Astro.url;
const ogImageUrl = new URL(config.brand.ogImagePath, siteOrigin).toString();
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body class="min-h-screen bg-page text-white">
    <header>
      <div class="border-b border-white/10 px-6 py-4">
        <div class="mx-auto flex max-w-6xl items-center justify-between gap-4">
          <div class="flex min-w-0 flex-shrink-0 items-center gap-3">
            <a href="/" class="flex-shrink-0 hover:opacity-80 transition" aria-label="All dashboards">
              <img src={config.brand.logoPath} alt={`${config.party.shortName} logo`} class="h-10 w-auto sm:h-12" />
            </a>
            <div class="min-w-0 truncate text-base font-semibold sm:text-lg">{config.project.name}</div>
          </div>
          <div class="hidden md:flex md:flex-1 md:justify-center">
            <DashboardNav activeSlug="budget" />
          </div>
          <a href={config.party.website} class="flex-shrink-0 text-sm text-wtp-cream/70 no-underline hover:text-wtp-sky">
            wtpppa.org →
          </a>
        </div>
      </div>
      <div class="border-b border-white/10 bg-white/[0.02] px-6 py-2 md:hidden">
        <DashboardNav activeSlug="budget" />
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-6 pt-8 md:pt-12 pb-16 md:pb-24">

      <!-- ── HERO: the clock ── -->
      <section>
        <p class="text-center text-xs uppercase tracking-[0.2em] text-wtp-sky">
          Pennsylvania's structural deficit
        </p>
        <h1 class="sr-only">Pennsylvania Structural Deficit Counter</h1>
        <div class="mt-8">
          <DeficitClock
            client:load
            fiscalYear="2026-27"
            annualDeficitUSD={annualDeficit}
          />
        </div>
        <p class="mt-4 text-center text-xs text-wtp-cream/45">
          Tracking FY 2026–27 — the current fiscal year, which began <strong class="text-wtp-cream/70">July 1</strong>. The budget for this year was signed July 12, 2026, but the structural deficit it's projected to run — $5.0 billion, per IFO's post-enactment estimate — wasn't fixed, only financed for one year.
        </p>
        <p class="mt-3 text-center text-sm">
          <a href="/budget/about" class="text-wtp-sky/80 no-underline hover:text-wtp-sky">About this dashboard →</a>
        </p>
      </section>

      <!-- ── ACT 1: HOW PA MONEY WORKS ── -->
      <section class="mt-16" id="how-it-works">
        <h2 class="text-3xl font-extrabold md:text-4xl">How Pennsylvania's money works</h2>
        <p class="mt-6 max-w-3xl text-base leading-relaxed text-wtp-cream/80">
          The <strong class="text-white">General Fund</strong> is the state's main operating budget. Each year it collects about <strong class="text-white">$45 billion</strong> — almost entirely from income and sales taxes paid by working Pennsylvanians — and spends about <strong class="text-white">$50 billion</strong> on services, mostly Medicaid and education.
        </p>

        <div class="mt-10 grid gap-6 lg:grid-cols-2">
          <BudgetBreakdown
            title="Where the money comes from"
            totalUSD={revenueSources.totalUSD}
            fiscalYear={revenueSources.fiscalYear}
            segments={revenueSources.sources}
            source={revenueSources.source.primary}
          />
          <BudgetBreakdown
            title="Where the money goes"
            totalUSD={spendingByCategory.totalUSD}
            fiscalYear={spendingByCategory.fiscalYear}
            segments={spendingByCategory.categories}
            source={spendingByCategory.source.primary}
          />
        </div>

        <p class="mt-4 max-w-3xl text-xs italic leading-relaxed text-wtp-cream/50">
          PA also collects many billions in dedicated fees and earmarked taxes — gas tax, lottery, and dozens of others — that flow to restricted funds outside the General Fund and never appear in "Where the money comes from." These breakdowns are FY 2025-26's actual enacted totals — the most recent full category-by-category detail the state has published. FY 2026-27's detailed breakdown isn't out yet. <a href="/budget/about#restricted-funds" class="text-wtp-sky no-underline hover:underline">Methodology →</a>
        </p>

        <p class="mt-10 max-w-3xl text-base leading-relaxed text-wtp-cream/80">
          That produced a <strong class="text-wtp-red">~${gapB} billion gap</strong> in FY 2025-26 — revenue came in well above what the enacted budget assumed. The clock above tracks the current year, FY 2026-27, where IFO's post-enactment estimate puts the <strong class="text-white">structural deficit at $5.0 billion</strong>, projected to reach <strong class="text-white">$8.4 billion</strong> by FY 2029-30 if nothing changes. These aren't the same measurement: the gap above is simple revenue-minus-spending for one year; the structural deficit strips out one-time swings to isolate the part of the mismatch that recurs.
        </p>

        <!-- Property tax flipper -->
        <details class="group mt-6 max-w-3xl rounded-lg border border-wtp-gold/20 bg-wtp-gold/[0.04] transition hover:border-wtp-gold/40">
          <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-3.5 [&::-webkit-details-marker]:hidden">
            <div class="text-xs uppercase tracking-[0.18em] text-wtp-gold">Wait — what about property tax?</div>
            <div class="flex-shrink-0 text-wtp-gold/60 transition group-open:rotate-180" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
          </summary>
          <div class="border-t border-wtp-gold/15 px-5 pb-4 pt-3 text-sm leading-relaxed text-wtp-cream/80">
            Pennsylvania property taxes don't appear above because they aren't <em>state</em> revenue. PA is one of the few states where property tax is collected and spent entirely by <strong class="text-white">local government</strong> — school districts (the largest share), counties, and municipalities — and never enters the state General Fund. That's why a Pennsylvanian can pay one of the highest property tax burdens in the country and still see a state-level structural deficit. Property tax reform is in <a href={`${config.party.website}/platform`} class="text-wtp-sky underline">our platform</a> — but the fix happens at the local and state-policy level, not in the state's revenue mix.
          </div>
        </details>

        <div class="mt-10">
          <ShareRow
            url={canonicalUrl}
            tweetText={`Pennsylvania has a $${annualB} billion structural deficit — and growing. Tracked live by ${config.party.shortName}.`}
          />
        </div>
      </section>

      <!-- ── ACT 2: THE WIDENING GAP ── -->
      <section class="mt-16">
        <SpendingRevenueTrend
          points={projections.growthTrend.points}
          note={projections.growthTrend.note}
        />

        <div class="mt-8 max-w-3xl rounded-lg border border-white/10 bg-surface/50 p-5">
          <div class="text-xs font-semibold uppercase tracking-[0.18em] text-wtp-cream/50">Why this matters</div>
          <p class="mt-3 text-sm leading-relaxed text-wtp-cream/75">
            A structural deficit isn't just a number — it's a recurring choice. The FY 2026–27 budget, signed <strong class="text-white">July 12, 2026</strong> — 12 days late, Pennsylvania's fifth straight late budget — chose not to touch the Rainy Day Fund Gov. Shapiro had proposed drawing down by $4.6B. Instead it closed the gap with one-time moves: roughly $1.7B swept from special funds and unspent agency accounts, over $4.5B in reclaimed lapsed appropriations, and $1.3B in delayed Medicaid managed-care payments. None of that repeats — Pennsylvania enters FY 2027–28 with fewer one-time levers left and the same underlying mismatch between spending and revenue. IFO's post-enactment estimate actually puts this year's structural deficit lower than expected — $5.0 billion, down from a pre-enactment projection of $6.7 billion — but that's an artifact of this year's one-time moves being counted in the number, not evidence the underlying mismatch shrank. It's still projected to reach $8.4 billion by FY 2029-30 if nothing changes. Pennsylvania's bond rating, which determines how much the state pays to borrow for roads, bridges, and schools, moves in direct response to this kind of fiscal pattern.
          </p>
        </div>
      </section>

      <!-- ── ACT 3: THE BUDGET DEADLINE ── -->
      <section class="mt-20" id="budget-deadline">
        <p class="text-xs uppercase tracking-[0.2em] text-wtp-sky">What happened</p>
        <h2 class="mt-2 text-3xl font-extrabold md:text-4xl">The budget deadline</h2>

        <p class="mt-6 max-w-3xl text-base leading-relaxed text-wtp-cream/80">
          The deficit clock above tracks <strong class="text-white">FY 2025–26</strong> — the fiscal year that just ended <strong class="text-white">June 30</strong>. The bigger fight was over <strong class="text-white">FY 2026–27</strong>, which began July 1 carrying a projected <strong class="text-wtp-red">$6.7 billion</strong> structural gap — nearly double the year before. Gov. Shapiro's proposed budget would have bridged most of it with a <strong class="text-white">$4.6B one-time Rainy Day Fund drawdown</strong>. The Republican-controlled Senate rejected that route, and the compromise that finally passed — signed <strong class="text-white">July 12, 2026</strong>, twelve days after the deadline — left the fund untouched entirely. IFO's post-enactment estimate has since put the gap at $5.0 billion, not because it's fixed, but because this year's one-time moves are now baked into the number.
        </p>

        <!-- What happens if June 30 passes -->
        <details class="group mt-6 max-w-3xl rounded-lg border border-white/10 bg-surface/50 transition hover:border-wtp-sky/30">
          <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-3.5 [&::-webkit-details-marker]:hidden">
            <div class="text-sm font-semibold text-wtp-cream/80">What actually happens if June 30 passes without a budget?</div>
            <div class="flex-shrink-0 text-wtp-cream/50 transition group-open:rotate-180" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
          </summary>
          <div class="border-t border-white/10 px-5 pb-4 pt-3 text-sm leading-relaxed text-wtp-cream/75">
            PA law requires a balanced budget signed by June 30. If the deadline passes unsigned, the state doesn't shut down entirely — courts have ruled that essential services and employee pay continue — but school districts, hospitals, and nonprofits that depend on state reimbursements stop getting paid. Smaller districts and nonprofits burn through cash reserves waiting; some take emergency loans. In FY 2024–25, the budget wasn't signed until <strong class="text-white">November 2025</strong> — 130 days late. This year was different: the FY 2026–27 budget was only 12 days late, short enough that most districts and nonprofits never felt it.
          </div>
        </details>

        <!-- Current status alert -->
        <div class="mt-6 max-w-3xl rounded-lg border border-wtp-gold/30 bg-wtp-gold/5 px-5 py-4">
          <div class="flex items-start gap-3">
            <span class="mt-0.5 flex-shrink-0 text-wtp-gold" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/><path d="M8 5v4M8 11v.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </span>
            <div class="text-sm leading-relaxed text-wtp-cream/80">
              <strong class="text-white">FY 2026–27 budget: enacted July 12, 2026.</strong>
              The $50.8B deal blocks tax increases and leaves the Rainy Day Fund untouched, closing the gap instead with one-time moves — agency and special-fund sweeps, reclaimed lapsed appropriations, and delayed Medicaid payments. It leaves skill-games regulation unresolved: the PA Supreme Court has ruled the machines are unlicensed slot machines, and lawmakers have until October to act before they become illegal.
            </div>
          </div>
        </div>

        <!-- Political timeline cards (surfaced) -->
        <div class="mt-8 max-w-3xl">
          <div class="text-xs font-semibold uppercase tracking-[0.18em] text-wtp-cream/50">The political calendar</div>
          <div class="mt-3 grid gap-3 sm:grid-cols-3 text-sm">
            <div class="rounded-md border border-white/10 bg-surface px-4 py-3">
              <div class="text-xs uppercase tracking-wider text-wtp-sky">June 30 – July 12</div>
              <div class="mt-1 text-wtp-cream/80">Deadline passes with no deal. Budget signed 12 days later — $50.8B, no tax hikes, Rainy Day Fund untouched.</div>
            </div>
            <div class="rounded-md border border-white/10 bg-surface px-4 py-3">
              <div class="text-xs uppercase tracking-wider text-wtp-gold">October 2026</div>
              <div class="mt-1 text-wtp-cream/80">Skill games deadline. Left out of the budget entirely — lawmakers must regulate the machines or the state Supreme Court's ruling makes them illegal.</div>
            </div>
            <div class="rounded-md border border-white/10 bg-surface px-4 py-3">
              <div class="text-xs uppercase tracking-wider text-wtp-red">January 2027</div>
              <div class="mt-1 text-wtp-cream/80">New governor takes office after the November 2026 election. Rainy Day Fund intact at ~$8B, but this year's one-time fixes are spent — the structural deficit is unresolved.</div>
            </div>
          </div>
          <p class="mt-3 text-xs leading-relaxed text-wtp-cream/45">
            Avoiding hard choices in an election year is documented across both parties in multiple states. This year's version didn't touch the marquee reserve — it swept smaller funds and delayed payments instead. Same effect, different mechanism: a one-time patch that doesn't recur, leaving the underlying mismatch for whoever holds office in 2027.
          </p>
        </div>
      </section>

      <!-- ── ACT 4: PATHS TO CLOSE THE GAP ── -->
      <section class="mt-20" id="paths-to-close-the-gap">
        <h2 class="text-3xl font-extrabold md:text-4xl">How could we close the gap?</h2>
        <p class="mt-6 max-w-3xl text-base leading-relaxed text-wtp-cream/80">
          The deficit isn't fate. There are real, named proposals on both the revenue and spending sides. Toggle any combination below to build your own plan — the running total updates as you go.
        </p>
        <div class="mt-8">
          <BudgetPlan
            client:load
            revenueProposals={rescueDoc.proposals as any}
            cutProposals={spendingCutsDoc.proposals as any}
            annualDeficitUSD={rescueDoc.annualDeficitUSD}
          />
        </div>
      </section>

      <!-- ── ACT 5: FEDERAL EXPOSURE ── -->
      <section class="mt-20">
        <FederalContext />
      </section>

      <section class="mt-16">
        <h2 class="text-3xl font-extrabold md:text-4xl">What could make the gap worse</h2>
        <p class="mt-6 max-w-3xl text-base leading-relaxed text-wtp-cream/80">
          Closing the gap is one direction. PA's structural exposure to federal funding shifts is the other. Federal flows are volatile across every administration, every budget cycle, every recession.
        </p>
        <div class="mt-8">
          <FederalCliffScenarios />
        </div>
        <details class="group mt-8 rounded-lg border border-white/10 bg-surface transition hover:border-wtp-sky/30">
          <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-5 [&::-webkit-details-marker]:hidden">
            <div>
              <div class="text-xs uppercase tracking-[0.2em] text-wtp-sky">By county</div>
              <div class="mt-1 text-base font-semibold text-white md:text-lg">See your county's federal-money exposure</div>
            </div>
            <div class="flex-shrink-0 text-wtp-cream/60 transition group-open:rotate-180" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </summary>
          <div class="border-t border-white/10 px-6 pb-6 pt-6">
            <CountyFederalImpact
              client:visible
              fiscalYear={federalByCounty.fiscalYear}
              totalObligationsUSD={federalByCounty.totalObligationsUSD}
              counties={federalByCounty.counties}
            />
          </div>
        </details>
      </section>

      <!-- ── PERSONAL IMPACT ── -->
      <section class="mt-20 grid items-start gap-6 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <PersonalImpactCalculator
            client:visible
            baseFamilyShareUSD={baseFamilyShareUSD}
            totalDeficitUSD={annualDeficit}
            totalHouseholds={population.households}
          />
        </div>
        <div class="space-y-4">
          <RainyDayCountdown rainyDayBalanceUSD={rainyDayUSD} />
          <p class="text-center text-xs text-wtp-cream/40">
            <a href="/budget/about#rainy-day" class="text-wtp-sky/70 no-underline hover:text-wtp-sky">Rainy Day Fund: law, history &amp; state comparisons →</a>
          </p>
        </div>
      </section>

      <section class="mt-8">
        <IFOPublications />
      </section>

      <section class="mt-20 overflow-hidden rounded-lg border border-wtp-sky/20 bg-gradient-to-br from-wtp-navy/60 to-wtp-indigo/40 p-8 text-center md:p-14">
        <p class="text-xs uppercase tracking-[0.25em] text-wtp-sky">Empowering People · Restoring Trust</p>
        <h2 class="mt-4 text-3xl font-extrabold leading-tight md:text-4xl">
          Want a state government that earns your trust?
        </h2>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-wtp-cream/90 md:text-lg">
          We The People Party of Pennsylvania believes accountability requires data, not slogans. If you want a different kind of state party — one that shows you the numbers and follows through — become a member.
        </p>
        <a
          href="https://www.wtpppa.org/membership"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-block rounded-md bg-wtp-sky px-8 py-4 text-sm font-bold uppercase tracking-[0.18em] text-wtp-navy no-underline transition hover:bg-wtp-cream"
        >
          Become a Member →
        </a>
      </section>
    </main>

    <SupportTipCTA />

    <footer class="border-t border-white/10 px-6 py-8 text-sm text-wtp-cream/60">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 md:flex-row md:justify-between">
        <div>Built by {config.party.name}</div>
        <div class="flex gap-4">
          <a href="/budget/about" class="hover:text-white">About</a>
          <a href={config.party.website} class="hover:text-white">wtpppa.org</a>
          <a href={config.party.socials.twitter} class="hover:text-white">X</a>
          <a href={config.party.socials.facebook} class="hover:text-white">Facebook</a>
        </div>
      </div>
    </footer>
  </body>
</html>
