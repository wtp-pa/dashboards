---
import { config } from '../../config';
import issuesDoc from '../../../data/quiz/issues.json';
import racesDoc from '../../../data/quiz/races.json';
import { appliesTo, type Issue, type Race } from '../../lib/quiz';
import QuizHead from '../../components/quiz/QuizHead.astro';
import QuizHeader from '../../components/quiz/QuizHeader.astro';
import '../../styles/global.css';

const issues = issuesDoc.issues as Issue[];
const races = (racesDoc.races as Race[]).filter((r) => !config.quiz.hiddenRaces.includes(r.id));
const domain = (u: string) => new URL(u).hostname.replace(/^www\./, '');
---

<html lang="en">
  <head>
    <QuizHead
      title={`Candidate positions + sources — Vote 2026 — ${config.party.shortName}`}
      description="Every Governor and U.S. House candidate's position on each quiz issue, with links to the public source."
    />
  </head>
  <body class="min-h-screen bg-page text-white">
    <QuizHeader />
    <main class="mx-auto max-w-3xl px-4 pt-8 pb-16 sm:px-6 md:pt-12">
      <h1 class="text-3xl font-extrabold">Every candidate, every source</h1>
      <p class="mt-3 text-base leading-relaxed text-wtp-cream/80">
        This page shows names. If you'd rather judge positions first, <a href="/vote2026/" class="text-wtp-sky">take the quiz</a>.
        These are our best reading of public statements and votes, not official or complete records, and not endorsements.
        Each position links to where we found it. Positions last checked {racesDoc.lastChecked}.
        Spot an error? <a href={config.party.website} class="text-wtp-sky">Tell us</a>.
      </p>

      <nav class="mt-6 flex flex-wrap gap-x-3 gap-y-1 text-sm" aria-label="Jump to race">
        {races.map((r) => <a href={`#${r.id}`} class="text-wtp-sky">{r.id === 'gov' ? 'Governor' : r.id.toUpperCase()}</a>)}
      </nav>

      {races.map((race) => {
        const raceIssues = issues.filter((i) => appliesTo(i, race));
        return (
          <section id={race.id} class="mt-10 scroll-mt-4">
            <h2 class="text-xl font-extrabold">{race.office}</h2>
            {race.counties?.length && <p class="text-xs text-wtp-cream/50">{race.counties.join(', ')}</p>}
            {race.candidates.map((c) => (
              <details class="mt-3 rounded-lg border border-white/10 bg-surface p-3">
                <summary class="cursor-pointer font-medium">
                  {c.name} <span class="text-sm font-normal text-wtp-cream/60">· {c.party}{c.incumbent ? ' · incumbent' : ''}</span>
                </summary>
                <ul class="mt-3 space-y-2 border-t border-white/10 pt-3 text-sm">
                  {raceIssues.map((issue) => {
                    const pos = c.positions[issue.id] ?? { options: [] };
                    const theirs = pos.options.map((id) => issue.options.find((o) => o.id === id)?.text);
                    return (
                      <li>
                        <div class="flex justify-between gap-2">
                          <span class="font-medium">{issue.topic}</span>
                        </div>
                        <p class="text-xs text-wtp-cream/60">
                          {theirs.length === 0 ? 'No public position' : theirs.length > 1 ? `Mixed record: ${theirs.join(' / ')}` : theirs[0]}
                        </p>
                        {pos.summary && (
                          <p class="mt-0.5 text-xs text-wtp-cream/70">
                            {pos.summary}{' '}
                            {pos.source && <a href={pos.source} target="_blank" rel="noopener" class="text-wtp-sky">{domain(pos.source)}</a>}
                          </p>
                        )}
                        {pos.record && (
                          <p class="mt-0.5 text-xs text-wtp-cream/50">
                            Record: {pos.record.summary}{' '}
                            <a href={pos.record.source} target="_blank" rel="noopener" class="text-wtp-sky">{domain(pos.record.source)}</a>
                          </p>
                        )}
                      </li>
                    );
                  })}
                </ul>
              </details>
            ))}
          </section>
        );
      })}

      <p class="mt-12 text-sm">
        <a href="/vote2026/" class="text-wtp-sky">← Take the quiz</a>
        <span class="mx-2 text-wtp-cream/30">·</span>
        <a href="/vote2026/about" class="text-wtp-sky">How we score</a>
      </p>
    </main>
  </body>
</html>
