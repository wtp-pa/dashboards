---
import { config } from '../../config';
import issuesDoc from '../../../data/quiz/issues.json';
import racesDoc from '../../../data/quiz/races.json';
import QuizHead from '../../components/quiz/QuizHead.astro';
import QuizHeader from '../../components/quiz/QuizHeader.astro';
import { MIN_SCORED } from '../../lib/quiz';
import '../../styles/global.css';

const candidateCount = racesDoc.races.reduce((n, r) => n + r.candidates.length, 0);
---

<html lang="en">
  <head>
    <QuizHead
      title={`How we score — Vote 2026 — ${config.party.shortName}`}
      description="How the Vote 2026 quiz picks issues, sources candidate positions, and calculates match scores."
    />
  </head>
  <body class="min-h-screen bg-page text-white">
    <QuizHeader />
    <main class="mx-auto max-w-3xl px-6 pt-8 pb-16 md:pt-12 md:pb-24">
      <h1 class="text-3xl font-extrabold">How the Vote 2026 quiz works</h1>
      <p class="mt-4 text-base leading-relaxed text-wtp-cream/80">
        {config.party.shortName} doesn't have candidates on the Nov 3 ballot in these races. This tool covers
        {racesDoc.races.length} races and {candidateCount} candidates: Governor and all 17 U.S. House seats, and every
        candidate on the ballot in them — Democrat, Republican, third-party, and independent. Ballot lists are checked
        against county election-office candidate listings and sample ballots. Write-in campaigns aren't included.
      </p>

      <section class="mt-10">
        <h2 class="text-2xl font-extrabold">The fairness rules</h2>
        <ul class="mt-4 space-y-3 text-base leading-relaxed text-wtp-cream/80">
          <li>— <strong class="text-white">Same rules for everyone.</strong> Party, incumbency, and polling don't change how a candidate is scored.</li>
          <li>— <strong class="text-white">Names stay hidden.</strong> You see positions first and choose when to reveal who holds them.</li>
          <li>— <strong class="text-white">Sourced or skipped.</strong> A position counts only if it links a public source: the candidate's website, a debate, a voter-guide survey (like Vote411), an interview, or an official vote. If we couldn't find one, it's "No public position" and left out of the score. Never counted against them, never guessed from party.</li>
          <li>— <strong class="text-white">Votes count as positions.</strong> Incumbents and former officeholders have a record. A vote is treated like any other public statement. When what someone said and how they voted point to different answers, we mark the position "Mixed," show both, and give them the average of the two. A vote on a bill that bundles unrelated things (for example, the 2026 bill pairing a stock-trading limit with voter ID) doesn't set a position by itself, for anyone.</li>
          <li>— <strong class="text-white">Coverage shown.</strong> Each score says how many of your answers it's based on. A candidate needs public positions on at least {MIN_SCORED} of the issues you answered to get a percentage, so one lucky overlap can't put a little-known candidate on top.</li>
          <li>— <strong class="text-white">Real options, not two sides.</strong> Most issues have more than two positions, so each question offers three or four distinct ones, plus "None of these fit my view." Agree/disagree questions nudge people toward "agree," so we follow <a href="https://www.pewresearch.org/writing-survey-questions/" class="text-wtp-sky underline" target="_blank" rel="noopener">Pew Research Center's advice</a> to offer a choice between alternatives. Where a choice has a real cost (taxes, spending, prices), the option names it. Options appear in order or reversed, at random.</li>
          <li>— <strong class="text-white">Options don't follow candidates.</strong> We wrote options to cover the views voters hold, not the ones candidates hold. Sometimes no candidate takes your position, and the results say so.</li>
          <li>— <strong class="text-white">No order hints.</strong> Candidates with the same score are listed in random order, so position in the list never gives away party or incumbency.</li>
        </ul>
      </section>

      <p class="mt-6 text-base">
        <a href="/vote2026/sources" class="text-wtp-sky">See every candidate's positions and sources →</a>
      </p>

      <section class="mt-10">
        <h2 class="text-2xl font-extrabold">The math</h2>
        <p class="mt-4 text-base leading-relaxed text-wtp-cream/80">
          For each issue, a candidate whose position is the same option you picked gets 100%. An option that partly
          overlaps yours gets 50% (the list below shows which ones overlap). Any other option gets 0%. A mixed record gets
          the average of its two options. Issues you mark "matters a lot" count double. Your match is the weighted average
          over issues where the candidate has a public position. "Not sure" and "None of these" are skipped. Scores built
          on fewer than 4 issues are marked as rough.
        </p>
        <p class="mt-3 text-base leading-relaxed text-wtp-cream/80">
          State issues are used only for Governor; federal issues only for U.S. House; shared issues for both.
        </p>
      </section>

      <section class="mt-10">
        <h2 class="text-2xl font-extrabold">The issues</h2>
        <ul class="mt-4 space-y-5 text-sm text-wtp-cream/80">
          {issuesDoc.issues.map((i) => {
            const text = (id: string) => i.options.find((o) => o.id === id)?.text.split(/[,.:;]/)[0];
            return (
              <li>
                <strong class="text-white">{i.topic}</strong>{i.short ? ' (quick + full)' : ' (full only)'}: {i.question}
                <ol class="mt-1 list-decimal space-y-0.5 pl-5">
                  {i.options.map((o) => <li>{o.text}</li>)}
                </ol>
                <p class="mt-1 text-xs text-wtp-cream/50">
                  Partial overlap: {i.near.map(([x, y]) => `"${text(x)}" and "${text(y)}"`).join('; ')}.
                </p>
              </li>
            );
          })}
        </ul>
      </section>

      <section class="mt-10">
        <h2 class="text-2xl font-extrabold">Privacy</h2>
        <p class="mt-4 text-base leading-relaxed text-wtp-cream/80">
          Your answers never leave your browser. We count anonymous events (quiz started, finished, names revealed, shared,
          which length and district you picked) with <a href="https://www.goatcounter.com" class="text-wtp-sky underline" target="_blank" rel="noopener">GoatCounter</a>,
          which uses no cookies. No names, emails, or answers are stored.
        </p>
      </section>

      <section class="mt-10">
        <h2 class="text-2xl font-extrabold">A note on AI</h2>
        <p class="mt-4 text-base leading-relaxed text-wtp-cream/80">
          We used <a href="https://www.anthropic.com/claude" class="text-wtp-sky underline" target="_blank" rel="noopener">Claude</a>,
          an AI assistant from Anthropic, to help write the code and to search for candidate positions. Every position links
          to the public source it came from so you can check it yourself. Positions last checked {racesDoc.lastChecked}.
          Found a mistake? <a href={config.party.website} class="text-wtp-sky underline">Let us know</a> and we'll fix it.
        </p>
      </section>

      <p class="mt-12"><a href="/vote2026/" class="text-wtp-sky">← Take the quiz</a></p>
    </main>
  </body>
</html>
