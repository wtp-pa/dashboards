---
import racesDoc from '../../../data/quiz/races.json';
import type { Race } from '../../lib/quiz';
import Admin from '../../components/quiz/Admin';
import QuizHead from '../../components/quiz/QuizHead.astro';
import QuizHeader from '../../components/quiz/QuizHeader.astro';
import '../../styles/global.css';

const races = (racesDoc.races as Race[]).map((r) => ({ id: r.id, office: r.office, candidateCount: r.candidates.length }));
---

<html lang="en">
  <head>
    <QuizHead title="Candidate Match — Officer admin" description="Usage and race settings." noindex />
  </head>
  <body class="min-h-screen bg-page text-white">
    <QuizHeader />
    <main class="mx-auto max-w-3xl px-4 pt-8 pb-16 sm:px-6">
      <h1 class="text-2xl font-extrabold">Candidate Match — officer admin</h1>
      <div class="mt-6">
        <Admin client:only="react" races={races} />
      </div>
    </main>
  </body>
</html>
